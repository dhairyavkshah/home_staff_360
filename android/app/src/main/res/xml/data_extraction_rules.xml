<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup rules (Google backup) -->
    <cloud-backup>
        <!-- Include WebView localStorage data -->
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        
        <!-- Include app-specific WebView data -->
        <include domain="root" path="app_webview" />
        <include domain="root" path="app_webview/Local Storage" />
        <include domain="root" path="app_webview/databases" />
    </cloud-backup>
    
    <!-- Device transfer rules -->
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="root" path="app_webview" />
        <include domain="root" path="app_webview/Local Storage" />
        <include domain="root" path="app_webview/databases" />
    </device-transfer>
</data-extraction-rules>
